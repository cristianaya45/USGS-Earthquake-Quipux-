{
  "info": {
    "name": "USGS Earthquake API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
      }
    },
    {
      "name": "List earthquakes",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/earthquakes?min_magnitude=2&sort_by=event_time&order=desc&page=1&page_size=20",
          "host": ["{{base_url}}"],
          "path": ["earthquakes"],
          "query": [
            { "key": "min_magnitude", "value": "2" },
            { "key": "max_magnitude", "value": "", "disabled": true },
            { "key": "location", "value": "", "disabled": true },
            { "key": "sort_by", "value": "event_time" },
            { "key": "order", "value": "desc" },
            { "key": "page", "value": "1" },
            { "key": "page_size", "value": "20" }
          ]
        }
      }
    },
    {
      "name": "List metrics",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/metrics",
          "host": ["{{base_url}}"],
          "path": ["metrics"],
          "query": [
            { "key": "window", "value": "2026-06-17T10", "disabled": true },
            { "key": "limit", "value": "50" },
            { "key": "skip", "value": "0" }
          ]
        }
      }
    },
    {
      "name": "List hourly reports",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/reports",
          "host": ["{{base_url}}"],
          "path": ["reports"],
          "query": [
            { "key": "limit", "value": "50" },
            { "key": "skip", "value": "0" }
          ]
        }
      }
    }
  ]
}
